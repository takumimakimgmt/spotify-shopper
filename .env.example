# Example only. Do NOT put real secrets here.
# Use a non-URL placeholder to avoid URL-allowlist scanners.
NEXT_PUBLIC_API_BASE_URL=DUMMY_API_BASE_URL
BACKEND_PROXY_TOKEN=replace-with-the-same-server-only-token-as-the-backend

# Public Beatport affiliate ID. Set in .env.local and hosting build settings.
NEXT_PUBLIC_BEATPORT_A_AID=

# Optional server-only Spotify PKCE connection (all three required).
# Use the same Spotify app as the Render backend. No Client Secret is needed on Vercel.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=
# Generate a random secret of at least 32 characters. Never use NEXT_PUBLIC_.
SPOTIFY_SESSION_SECRET=
